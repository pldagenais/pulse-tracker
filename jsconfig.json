{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": ["server/**/*.js", "server/**/*.d.ts", "hooks/*.mjs", "scripts/*.mjs"],
  "//": "convex/ is TypeScript with bundler resolution — checked by its own tsconfig",
  "exclude": ["convex", "node_modules", "web"]
}
